# Model API. Either one works; Gemini is picked first when both are set,
# because it has a free tier. Force one with WATCHTOWER_LLM_PROVIDER
# (watchtower) or SCAMSCAN_PROVIDER (scamscan): gemini | anthropic.
# Gemini free key: https://aistudio.google.com/api-keys
# NOTE: the free tier covers text generation but NOT Google Search grounding on
# Gemini 3.x, so scamscan's hunt needs either Anthropic or Gemini billing.
# watchtower scoring works fine on the free tier.
GEMINI_API_KEY=
# Optional model overrides — `python scamscan.py models` lists what your
# key can actually reach.
# GEMINI_TRIAGE_MODEL=gemini-3.5-flash-lite
# GEMINI_DEEP_MODEL=gemini-3.7-flash
# SCAMSCAN_GEMINI_MODEL=gemini-3.5-flash

# Copy to .env and fill in. .env is gitignored — never commit real keys.
#
#   cp .env.example .env
#   $EDITOR .env
#
# run.py loads .env automatically, so `python run.py serve` picks these up.
# Everything still runs with none of them set; you just lose the feature.

# Relevance scoring and summaries. Without it you get keyword ranking.
# Get one at https://console.anthropic.com/  (paid, usage-based)
ANTHROPIC_API_KEY=

# Sanctions / PEP / watchlist matching. Without it that source reports
# "not searched" rather than a misleading zero.
# Free key at https://www.opensanctions.org/api/
OPENSANCTIONS_API_KEY=

# --- Optional sources. Each one skips visibly if unset, never silently. ---

# Company registries across 140+ jurisdictions.
# https://api.opencorporates.com/
OPENCORPORATES_API_KEY=

# Reddit: create a "script" app at https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# X/Twitter recent search. Paid tier required (~$200/mo Basic).
# Official API only — scraping X is deliberately not supported, see CLAUDE.md
X_BEARER_TOKEN=
# Cross-platform public social search. Universal Search uses 20 credits/call,
# so it is opt-in: select `socialcrawl` explicitly in the UI or CLI.
# https://www.socialcrawl.dev/
SOCIALCRAWL_API_KEY=
X_USER_AGENT=
TIKTOK_ACCESS_TOKEN=
DATABASE_URL=

# --- Deployment (serverless hosts only) ---
# WATCHTOWER_PASSWORD=        # required off localhost, or the app serves 503
# WATCHTOWER_USER=watchtower
# WATCHTOWER_BIND_HOST=127.0.0.1  # run.py sets this; public binds require a password
# WATCHTOWER_DATA_DIR=        # a real volume, to make the archive persistent

# A reachable contact address, sent in the User-Agent. SEC EDGAR answers 403
# without one and Wikipedia asks for it. Kept here, not in config.yaml, so it
# is never committed.
WATCHTOWER_CONTACT=you@example.com

# --- Free-first investigation engine (all enabled by default) ---
# Set any provider to false to disable it. None require billing or a card.
ENABLE_DUCKDUCKGO=true
ENABLE_SOCIAL_WEB_INDEX=true
ENABLE_COMMONCRAWL=true
ENABLE_CT=true
ENABLE_RDAP=true
ENABLE_DNS=true
ENABLE_IP_ASN=true
ENABLE_TLS=true
ENABLE_URLHAUS=true
ENABLE_THREATFOX=true
ZERO_KEY_MODE=true
MAX_PIVOT_DEPTH=2
MAX_PAGE_FETCHES=20
MAX_GLOBAL_REQUESTS=8

# Maximum wall time for an interactive browser sweep. CLI sweeps are unbounded.
WATCHTOWER_SWEEP_BUDGET=30
# Required by the optional local SearXNG service. Generate with:
# openssl rand -hex 32
SEARXNG_SECRET=

# --- Autonomous hunter (HUNTER.md). All optional. ---
# Identifies the hunter to the sites, registries and search engines it contacts.
# WATCHTOWER_CONTACT=you@example.org
# WATCHTOWER_USER_AGENT=Watchtower/1.0 OSINT (contact: you@example.org)
# An https URL that receives alerts (domain, score, signal names; never personal data). Unset = alerts stay local.
# WATCHTOWER_ALERT_WEBHOOK=
# The scheduler refuses to run on temporary storage. Set WATCHTOWER_DATA_DIR to a persistent volume, or this for a demo:
# WATCHTOWER_ALLOW_EPHEMERAL=1
